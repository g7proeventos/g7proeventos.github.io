
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Inscrição de atletas - G7PRO</title>
  <meta name="description" content="Inscrição de atletas pelo professor - G7PRO Gestão de Eventos">
  <meta name="theme-color" content="#0f172a">
  <link rel="icon" type="image/png" href="../favicon.png">
  <style>
    :root { --preto: #0f172a; --preto-2: #1e293b; --azul: #1d4ed8; --azul-claro: #dbeafe; --azul-vivo: #60a5fa;
      --cinza-1: #f1f5f9; --cinza-2: #e2e8f0; --cinza-3: #94a3b8; --cinza-4: #475569; --verde: #16a34a; --vermelho: #dc2626; --raio: 14px; }
    * { box-sizing: border-box; min-width: 0; }
    [hidden] { display: none !important; }
    body { margin: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Inter, Arial, sans-serif; background: var(--cinza-1); color: var(--preto); line-height: 1.45; }
    button, input, select { font: inherit; }
    .barra { background: var(--preto); color: #fff; }
    .barra .wrap { max-width: 860px; margin: 0 auto; padding: 10px 14px; display: flex; justify-content: space-between; align-items: center; gap: 10px; }
    .marca { display: flex; align-items: center; gap: 9px; font-weight: 900; color: #fff; text-decoration: none; }
    .marca img { width: 36px; height: 35px; background: #fff; border-radius: 8px; padding: 2px; }
    .marca span span { color: var(--azul-vivo); }
    .voltar { color: #bfdbfe; font-weight: 800; font-size: .85rem; text-decoration: none; white-space: nowrap; }
    .wrap { max-width: 860px; margin: 0 auto; padding: 0 14px 60px; }

    .evento { background: #fff; border: 1px solid var(--cinza-2); border-left: 7px solid var(--azul); border-radius: var(--raio); padding: 14px 18px; margin: 18px 0 14px; }
    .evento small { color: var(--azul); font-weight: 900; letter-spacing: 2px; font-size: .72rem; }
    .evento h1 { margin: 2px 0 4px; font-size: 1.5rem; line-height: 1.15; }
    .evento p { margin: 0; color: var(--cinza-4); font-weight: 700; font-size: .92rem; }

    .passos { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin-bottom: 14px; }
    .passo { background: #fff; border: 2px solid var(--cinza-2); border-radius: 12px; padding: 9px 10px; display: flex; gap: 8px; align-items: center; font-weight: 800; color: var(--cinza-3); font-size: .9rem; }
    .passo b { width: 26px; height: 26px; border-radius: 50%; background: var(--cinza-2); color: var(--cinza-4); display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: .85rem; }
    .passo.ativo { border-color: var(--azul); color: var(--preto); }
    .passo.ativo b { background: var(--azul); color: #fff; }
    .passo.feito { color: var(--preto); }
    .passo.feito b { background: var(--verde); color: #fff; }

    .painel { background: #fff; border: 1px solid var(--cinza-2); border-radius: var(--raio); padding: 18px; box-shadow: 0 2px 10px rgba(15,23,42,.05); }
    .painel h2 { margin: 0 0 4px; font-size: 1.2rem; }
    .painel .ajuda { margin: 0 0 16px; color: var(--cinza-4); font-size: .92rem; }
    .grade { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    .inteiro { grid-column: 1 / -1; }
    label.campo { display: flex; flex-direction: column; gap: 5px; font-size: .82rem; font-weight: 800; color: var(--cinza-4); }
    input[type=text], input[type=email], input[type=tel], input[type=date], input[type=number], select {
      width: 100%; min-height: 46px; padding: 10px 12px; border: 1.5px solid #cbd5e1; border-radius: 10px; background: #fff; color: var(--preto); font-size: 16px; font-weight: 500; }
    input:focus, select:focus { outline: 3px solid rgba(29,78,216,.25); border-color: var(--azul); }
    .erro-campo { border-color: var(--vermelho) !important; background: #fff7f7 !important; }
    .msg-erro { color: var(--vermelho); font-size: .82rem; font-weight: 700; min-height: 1px; }

    .atleta { border: 1.5px solid var(--cinza-2); border-radius: 12px; padding: 14px; margin-bottom: 12px; background: #fcfdff; }
    .atleta-cab { display: flex; justify-content: space-between; align-items: center; gap: 8px; margin-bottom: 10px; }
    .atleta-cab b { font-size: 1rem; }
    .atleta-cab .acoes-at { display: flex; gap: 6px; }
    .seg { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }
    .seg button { min-height: 46px; border: 1.5px solid #cbd5e1; background: #fff; border-radius: 10px; font-weight: 800; color: var(--cinza-4); cursor: pointer; }
    .seg button.sel { background: var(--azul); border-color: var(--azul); color: #fff; }
    .info-idade { font-size: .8rem; font-weight: 700; color: var(--azul); min-height: 1em; }
    .festival { display: flex; gap: 10px; align-items: center; background: #f5f3ff; border: 1px solid #ddd6fe; border-radius: 10px; padding: 10px 12px; font-weight: 800; color: #5b21b6; cursor: pointer; }
    .festival input { width: 20px; height: 20px; accent-color: #7c3aed; }

    .bt { border: 0; border-radius: 10px; min-height: 46px; padding: 11px 18px; font-weight: 900; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; gap: 8px; text-decoration: none; }
    .bt-azul { background: var(--azul); color: #fff; }
    .bt-azul:disabled { opacity: .5; cursor: not-allowed; }
    .bt-claro { background: #fff; color: var(--preto); border: 1.5px solid var(--cinza-2); }
    .bt-mini { min-height: 36px; padding: 6px 12px; font-size: .82rem; }
    .bt-perigo { background: #fff; color: var(--vermelho); border: 1.5px solid #fecaca; }
    .bt-add { width: 100%; background: var(--azul-claro); color: var(--azul); border: 2px dashed #93c5fd; }
    .rodape-passo { display: flex; justify-content: space-between; gap: 10px; margin-top: 18px; flex-wrap: wrap; }
    .rodape-passo .bt { flex: 1 1 160px; }

    table.resumo { width: 100%; border-collapse: collapse; font-size: .9rem; margin-bottom: 14px; }
    table.resumo th { text-align: left; font-size: .72rem; letter-spacing: 1px; text-transform: uppercase; color: var(--cinza-4); padding: 8px; border-bottom: 2px solid var(--preto); }
    table.resumo td { padding: 9px 8px; border-bottom: 1px solid var(--cinza-2); vertical-align: top; }
    table.resumo td b { display: block; }
    table.resumo td span { color: var(--cinza-3); font-size: .78rem; font-weight: 700; }
    .termos { border: 1px solid var(--cinza-2); border-radius: 12px; overflow: hidden; margin-bottom: 12px; }
    .termos summary { cursor: pointer; padding: 12px 14px; font-weight: 800; background: var(--cinza-1); }
    .termos .texto { padding: 12px 14px; font-size: .88rem; line-height: 1.55; color: #1e293b; max-height: 300px; overflow-y: auto; }
    .termos .texto p { margin: 0 0 9px; }
    .aceite { display: flex; gap: 10px; align-items: flex-start; font-weight: 700; font-size: .92rem; margin: 10px 0; cursor: pointer; }
    .aceite input { width: 22px; height: 22px; flex-shrink: 0; margin-top: 1px; accent-color: var(--azul); }
    .armadilha { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
    .alerta { border-radius: 10px; padding: 12px 14px; font-weight: 700; font-size: .92rem; margin-top: 12px; }
    .alerta.erro { background: #fee2e2; color: #991b1b; }
    .alerta.info { background: var(--azul-claro); color: #1e3a8a; }

    .sucesso { text-align: center; }
    .sucesso .ok { width: 74px; height: 74px; border-radius: 50%; background: #dcfce7; color: var(--verde); font-size: 2.4rem; display: flex; align-items: center; justify-content: center; margin: 4px auto 10px; font-weight: 900; }
    .protocolo { display: inline-block; font-family: "SF Mono", Menlo, Consolas, monospace; font-size: 1.6rem; font-weight: 900; letter-spacing: 1px; background: var(--preto); color: #fff; border-radius: 10px; padding: 8px 16px; margin: 8px 0 6px; }
    .fechado { text-align: center; padding: 30px 18px; }
    .fechado .ico { font-size: 2.6rem; }
    .carregando { text-align: center; padding: 40px; color: var(--cinza-4); font-weight: 700; }

    @media (max-width: 600px) {
      .grade { grid-template-columns: 1fr; }
      .passo { flex-direction: column; text-align: center; font-size: .78rem; gap: 4px; }
      .evento h1 { font-size: 1.25rem; }
      table.resumo .esconder { display: none; }
    }
  </style>
</head>
<body>
  <header class="barra">
    <div class="wrap">
      <a class="marca" href="../"><img src="../logo-g7pro.png" alt="G7PRO"><span>G7<span>PRO</span> · Inscrições</span></a>
      <a class="voltar" href="../evento/">← Voltar ao evento</a>
    </div>
  </header>

  <main class="wrap">
    <div class="evento">
      <small>INSCRIÇÃO DE ATLETAS</small>
      <h1 id="nomeEvento">Carregando evento...</h1>
      <p id="infoEvento"></p>
    </div>

    <div id="carregando" class="painel carregando">Carregando...</div>

    <div id="fechado" class="painel fechado" hidden>
      <div class="ico">🔒</div>
      <h2>Inscrições fechadas</h2>
      <p class="ajuda">As inscrições pelo site não estão abertas no momento. Fale com a organização do evento.</p>
      <a class="bt bt-claro" href="../evento/">Ver o evento</a>
    </div>

    <div id="formulario" hidden>
      <div class="passos">
        <div class="passo ativo" data-p="1"><b>1</b>Professor</div>
        <div class="passo" data-p="2"><b>2</b>Atletas</div>
        <div class="passo" data-p="3"><b>3</b>Confirmar</div>
      </div>

      <!-- PASSO 1 -->
      <section class="painel" id="passo1">
        <h2>Dados do professor</h2>
        <p class="ajuda">Você preenche uma vez e inscreve quantos alunos quiser.</p>
        <div class="grade">
          <label class="campo inteiro">Nome do professor *<input type="text" id="profNome" maxlength="80" autocomplete="name"><span class="msg-erro"></span></label>
          <label class="campo inteiro">Equipe / academia *<input type="text" id="profEquipe" maxlength="80" placeholder="Como deve aparecer na chave"><span class="msg-erro"></span></label>
          <label class="campo">WhatsApp *<input type="tel" id="profWhats" maxlength="16" inputmode="tel" autocomplete="tel" placeholder="(21) 99999-9999"><span class="msg-erro"></span></label>
          <label class="campo">E-mail (para receber a confirmação)<input type="email" id="profEmail" maxlength="100" autocomplete="email"><span class="msg-erro"></span></label>
        </div>
        <div class="rodape-passo"><span></span><button class="bt bt-azul" id="irPasso2">Continuar → Atletas</button></div>
      </section>

      <!-- PASSO 2 -->
      <section class="painel" id="passo2" hidden>
        <h2>Atletas <span id="contAtletas" style="color:var(--azul)"></span></h2>
        <p class="ajuda">Inclua até 20 atletas por envio. Para mais, envie de novo depois.</p>
        <div id="listaAtletas"></div>
        <button class="bt bt-add" id="btAdd">+ Adicionar atleta</button>
        <div class="rodape-passo">
          <button class="bt bt-claro" id="voltarPasso1">← Professor</button>
          <button class="bt bt-azul" id="irPasso3">Revisar inscrição →</button>
        </div>
      </section>

      <!-- PASSO 3 -->
      <section class="painel" id="passo3" hidden>
        <h2>Confira e envie</h2>
        <p class="ajuda" id="resumoProf"></p>
        <div style="overflow-x:auto"><table class="resumo" id="tabelaResumo"></table></div>

        <details class="termos">
          <summary>📄 Ler os termos (LGPD, imagem e aptidão física)</summary>
          <div class="texto" id="textoTermos"></div>
        </details>
        <label class="aceite"><input type="checkbox" id="aceiteLgpd"> <span>Li e concordo com o uso de dados e de imagem, e declaro ter a autorização dos responsáveis pelos atletas menores de idade.</span></label>
        <label class="aceite"><input type="checkbox" id="aceiteSaude"> <span>Declaro que os atletas estão clinicamente aptos para a atividade física e estou ciente dos riscos de lesão.</span></label>
        <label class="armadilha" aria-hidden="true">Site<input type="text" id="siteWeb" tabindex="-1" autocomplete="off"></label>

        <div class="alerta erro" id="erroEnvio" hidden></div>
        <div class="rodape-passo">
          <button class="bt bt-claro" id="voltarPasso2">← Atletas</button>
          <button class="bt bt-azul" id="btEnviar" disabled>✅ Enviar inscrição</button>
        </div>
      </section>

      <!-- SUCESSO -->
      <section class="painel sucesso" id="passoOk" hidden>
        <div class="ok">✓</div>
        <h2>Inscrição recebida!</h2>
        <div class="protocolo" id="numProtocolo">-</div>
        <p class="ajuda" id="textoOk"></p>
        <div class="rodape-passo" style="justify-content:center">
          <button class="bt bt-claro" id="btCopiar">📋 Copiar protocolo</button>
          <button class="bt bt-azul" id="btNova">+ Inscrever mais atletas</button>
        </div>
        <p style="margin-top:14px"><a href="../evento/#atletas" style="color:var(--azul); font-weight:800">Ver a checagem de atletas do evento →</a></p>
      </section>
    </div>
  </main>

  <script src="../config.js"></script>
  <script>
  {
    const CFG = window.G7PRO_CONFIG || {};
    const FAIXAS = ["Branca", "Cinza e Branca", "Cinza", "Cinza e Preta", "Amarela e Branca", "Amarela", "Amarela e Preta",
      "Laranja e Branca", "Laranja", "Laranja e Preta", "Verde e Branca", "Verde", "Verde e Preta", "Azul", "Roxa", "Marrom", "Preta"];
    const PESOS = ["Galo", "Pluma", "Pena", "Leve", "Médio", "Meio-Pesado", "Pesado", "Super Pesado", "Pesadíssimo", "Absoluto"];
    const MAX = 20, CHAVE_RASCUNHO = "g7pro_inscricao_rascunho";
    const $ = (id) => document.getElementById(id);
    const esc = (t) => String(t == null ? "" : t).replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));

    let evento = {}, anoEvento = new Date().getFullYear();
    let atletas = [];

    // ---------- rascunho (fica só neste aparelho) ----------
    function salvarRascunho() {
      try {
        localStorage.setItem(CHAVE_RASCUNHO, JSON.stringify({
          prof: { nome: $("profNome").value, equipe: $("profEquipe").value, whats: $("profWhats").value, email: $("profEmail").value },
          atletas: atletas
        }));
      } catch (e) {}
    }
    function lerRascunho() {
      try {
        const r = JSON.parse(localStorage.getItem(CHAVE_RASCUNHO) || "null");
        if (!r) return;
        $("profNome").value = r.prof.nome || ""; $("profEquipe").value = r.prof.equipe || "";
        $("profWhats").value = r.prof.whats || ""; $("profEmail").value = r.prof.email || "";
        if (Array.isArray(r.atletas)) atletas = r.atletas.slice(0, MAX);
      } catch (e) {}
    }
    function limparRascunhoAtletas() { atletas = []; salvarRascunho(); }

    // ---------- navegação ----------
    function irPara(n) {
      ["passo1", "passo2", "passo3", "passoOk"].forEach((id, i) => { $(id).hidden = (i + 1) !== n; });
      document.querySelectorAll(".passo").forEach((p) => {
        const k = Number(p.dataset.p);
        p.classList.toggle("ativo", k === n);
        p.classList.toggle("feito", k < n || n === 4);
      });
      window.scrollTo({ top: 0, behavior: "smooth" });
    }

    // ---------- validação ----------
    function marcarErro(input, msg) {
      input.classList.toggle("erro-campo", !!msg);
      const span = input.parentElement.querySelector(".msg-erro");
      if (span) span.textContent = msg || "";
      return !msg;
    }
    function validarProfessor() {
      let ok = true;
      ok = marcarErro($("profNome"), $("profNome").value.trim().length < 3 ? "Informe o nome do professor." : "") && ok;
      ok = marcarErro($("profEquipe"), $("profEquipe").value.trim().length < 2 ? "Informe a equipe." : "") && ok;
      ok = marcarErro($("profWhats"), $("profWhats").value.replace(/\D/g, "").length < 10 ? "Informe o WhatsApp com DDD." : "") && ok;
      const em = $("profEmail").value.trim();
      ok = marcarErro($("profEmail"), em && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(em) ? "Confira o e-mail." : "") && ok;
      return ok;
    }
    $("profWhats").addEventListener("input", function () {
      const d = this.value.replace(/\D/g, "").slice(0, 11);
      this.value = d.length > 6 ? "(" + d.slice(0, 2) + ") " + d.slice(2, d.length - 4) + "-" + d.slice(-4) : (d.length > 2 ? "(" + d.slice(0, 2) + ") " + d.slice(2) : d);
    });

    function idadeNoAno(nasc) {
      const m = String(nasc || "").match(/^(\d{4})-/);
      return m ? anoEvento - Number(m[1]) : null;
    }

    function novoAtleta() { return { n: "", d: "", s: "", f: "", p: "", k: "", fe: 0 }; }

    function htmlAtleta(a, i) {
      const idade = idadeNoAno(a.d);
      const ehKids = idade !== null && idade >= 4 && idade <= 7;
      return '<div class="atleta" data-i="' + i + '">' +
        '<div class="atleta-cab"><b>Atleta ' + (i + 1) + '</b><div class="acoes-at">' +
          '<button class="bt bt-mini bt-claro" data-acao="copiar" title="Novo atleta com a mesma faixa e sexo">Duplicar</button>' +
          '<button class="bt bt-mini bt-perigo" data-acao="remover">Remover</button></div></div>' +
        '<div class="grade">' +
          '<label class="campo inteiro">Nome completo do atleta *<input type="text" data-c="n" maxlength="80" value="' + esc(a.n) + '" autocomplete="off"><span class="msg-erro"></span></label>' +
          '<label class="campo">Data de nascimento *<input type="date" data-c="d" value="' + esc(a.d) + '"><span class="info-idade">' + (idade !== null && idade > 0 ? idade + " anos em " + anoEvento : "") + '</span></label>' +
          '<div class="campo"><span style="font-size:.82rem;font-weight:800;color:var(--cinza-4)">Sexo *</span><div class="seg">' +
            '<button type="button" data-sexo="MASCULINO" class="' + (a.s === "MASCULINO" ? "sel" : "") + '">Masculino</button>' +
            '<button type="button" data-sexo="FEMININO" class="' + (a.s === "FEMININO" ? "sel" : "") + '">Feminino</button></div><span class="msg-erro" data-erro="s"></span></div>' +
          '<label class="campo">Faixa *<select data-c="f"><option value="">Selecione</option>' + FAIXAS.map((f) => '<option' + (a.f === f ? " selected" : "") + '>' + f + '</option>').join("") + '</select><span class="msg-erro"></span></label>' +
          (a.fe ? '' :
          '<label class="campo">Categoria de peso *<select data-c="p"><option value="">Selecione</option>' + PESOS.map((p) => '<option' + (a.p === p ? " selected" : "") + '>' + p + '</option>').join("") + '</select><span class="msg-erro"></span></label>' +
          '<label class="campo">Peso em kg (opcional)<input type="number" data-c="k" inputmode="decimal" min="10" max="250" step="0.1" value="' + esc(a.k) + '" placeholder="Ex.: 42,5"><span class="msg-erro"></span></label>') +
          ((ehKids || a.fe) ? '<label class="festival inteiro"><input type="checkbox" data-c="fe"' + (a.fe ? " checked" : "") + '> 🧸 Inscrever no Festival Kids (4 a 7 anos)</label>' : '') +
        '</div></div>';
    }

    function desenharAtletas() {
      if (!atletas.length) atletas.push(novoAtleta());
      $("listaAtletas").innerHTML = atletas.map(htmlAtleta).join("");
      $("contAtletas").textContent = "(" + atletas.length + ")";
      $("btAdd").hidden = atletas.length >= MAX;
    }

    $("listaAtletas").addEventListener("input", (e) => {
      const card = e.target.closest(".atleta"); if (!card) return;
      const i = Number(card.dataset.i), c = e.target.dataset.c; if (!c) return;
      if (c === "fe") { atletas[i].fe = e.target.checked ? 1 : 0; if (atletas[i].fe) atletas[i].p = ""; salvarRascunho(); desenharAtletas(); return; }
      atletas[i][c] = e.target.value;
      if (c === "d") {
        const idade = idadeNoAno(atletas[i].d);
        const info = e.target.parentElement.querySelector(".info-idade");
        info.style.color = ""; e.target.classList.remove("erro-campo");
        info.textContent = idade !== null && idade > 0 && idade < 100 ? idade + " anos em " + anoEvento : "";
        const podeKids = idade !== null && idade >= 4 && idade <= 7;
        const temCaixa = !!card.querySelector(".festival");
        if (!podeKids) atletas[i].fe = 0;
        salvarRascunho();
        if (podeKids !== temCaixa) { desenharAtletas(); const d2 = document.querySelector('.atleta[data-i="' + i + '"] input[data-c="d"]'); if (d2) d2.focus(); }
        return;
      }
      marcarErro(e.target, "");
      salvarRascunho();
    });
    $("listaAtletas").addEventListener("click", (e) => {
      const card = e.target.closest(".atleta"); if (!card) return;
      const i = Number(card.dataset.i);
      if (e.target.dataset.sexo) { atletas[i].s = e.target.dataset.sexo; salvarRascunho(); desenharAtletas(); return; }
      const acao = e.target.dataset.acao;
      if (acao === "remover") { atletas.splice(i, 1); salvarRascunho(); desenharAtletas(); }
      if (acao === "copiar" && atletas.length < MAX) {
        const b = novoAtleta(); b.s = atletas[i].s; b.f = atletas[i].f;
        atletas.splice(i + 1, 0, b); salvarRascunho(); desenharAtletas();
        const novo = document.querySelector('.atleta[data-i="' + (i + 1) + '"] input[data-c="n"]'); if (novo) novo.focus();
      }
    });
    $("btAdd").addEventListener("click", () => {
      if (atletas.length >= MAX) return;
      atletas.push(novoAtleta()); salvarRascunho(); desenharAtletas();
      const cards = document.querySelectorAll(".atleta"); const ult = cards[cards.length - 1];
      ult.scrollIntoView({ behavior: "smooth", block: "center" }); ult.querySelector('input[data-c="n"]').focus();
    });

    function validarAtletas() {
      let primeiroErro = null;
      atletas.forEach((a, i) => {
        const card = document.querySelector('.atleta[data-i="' + i + '"]');
        const q = (c) => card.querySelector('[data-c="' + c + '"]');
        const nome = a.n.trim().replace(/\s+/g, " ");
        const idade = idadeNoAno(a.d);
        const erros = [
          [q("n"), nome.length < 5 || nome.indexOf(" ") === -1 ? "Informe nome e sobrenome." : ""],
          [q("f"), !a.f ? "Escolha a faixa." : ""]
        ];
        if (!a.fe) {
          erros.push([q("p"), !a.p ? "Escolha a categoria de peso." : ""]);
          if (a.k && (Number(a.k) < 10 || Number(a.k) > 250)) erros.push([q("k"), "Peso em kg inválido."]);
        }
        erros.forEach(([el, msg]) => { if (el && !marcarErro(el, msg) && !primeiroErro) primeiroErro = el; });
        const dInput = q("d");
        const dErro = !a.d || idade === null || idade < 3 || idade > 90 ? "Confira a data de nascimento." : "";
        dInput.classList.toggle("erro-campo", !!dErro);
        dInput.parentElement.querySelector(".info-idade").textContent = dErro || (idade + " anos em " + anoEvento);
        dInput.parentElement.querySelector(".info-idade").style.color = dErro ? "var(--vermelho)" : "";
        if (dErro && !primeiroErro) primeiroErro = dInput;
        const sErro = card.querySelector('[data-erro="s"]');
        sErro.textContent = a.s ? "" : "Escolha o sexo.";
        if (!a.s && !primeiroErro) primeiroErro = card.querySelector(".seg");
      });
      // nomes repetidos no mesmo envio
      const vistos = {};
      atletas.forEach((a, i) => {
        const k = a.n.trim().toUpperCase() + "|" + a.d;
        if (vistos[k] !== undefined && a.n.trim()) {
          const el = document.querySelector('.atleta[data-i="' + i + '"] [data-c="n"]');
          marcarErro(el, "Atleta repetido nesta inscrição."); if (!primeiroErro) primeiroErro = el;
        }
        vistos[k] = i;
      });
      if (primeiroErro) primeiroErro.scrollIntoView({ behavior: "smooth", block: "center" });
      return !primeiroErro;
    }

    // ---------- termos ----------
    function textoTermos() {
      const ev = esc(evento.nome || "o evento");
      return "<p>Ao inscrever atletas, o professor declara que:</p>" +
        "<p><b>1. Dados pessoais.</b> Autoriza a organização de " + ev + " a tratar os dados informados (nome, data de nascimento, sexo, faixa, peso, equipe e contato do professor) para inscrição, pesagem, montagem de chaves e lutas, cronograma, premiação e divulgação de resultados, conforme a Lei Geral de Proteção de Dados (Lei 13.709/2018).</p>" +
        "<p><b>2. Divulgação pública.</b> Nome, equipe, faixa, peso, horários e resultados do atleta serão exibidos na página pública do evento. Data de nascimento e telefone não são divulgados.</p>" +
        "<p><b>3. Direito de imagem.</b> Autoriza, sem custo, o uso de fotos e vídeos do atleta feitos durante o evento, para divulgação do evento e do esporte em redes sociais, site e materiais da organização.</p>" +
        "<p><b>4. Menores de 18 anos.</b> Declara ter a autorização dos pais ou responsáveis legais de cada atleta menor de idade inscrito, inclusive para o uso de imagem.</p>" +
        "<p><b>5. Direitos do titular.</b> O atleta ou seu responsável pode pedir à organização, a qualquer momento, acesso, correção ou exclusão dos seus dados. Os dados são guardados apenas pelo tempo necessário ao evento e às obrigações legais.</p>" +
        "<p><b>6. Aptidão física e riscos.</b> Em nome do atleta e, se menor de idade, também dos pais ou responsáveis legais, o professor declara que: o atleta está clinicamente apto para praticar atividade física e competir, sem restrição médica conhecida; tem ciência de que se trata de uma competição de luta, com contato físico, em que podem ocorrer lesões; caso ocorra alguma lesão, a responsabilidade é do próprio atleta ou de seus responsáveis legais; e cabe à organização de " + ev + " manter no local uma equipe médica para o primeiro atendimento e o socorro de emergência.</p>";
    }

    function montarResumo() {
      $("resumoProf").innerHTML = "Professor <b>" + esc($("profNome").value.trim()) + "</b> · Equipe <b>" + esc($("profEquipe").value.trim()) + "</b> · " + esc($("profWhats").value);
      $("tabelaResumo").innerHTML = "<tr><th>Atleta</th><th>Faixa</th><th>Peso</th><th class='esconder'>Sexo</th></tr>" +
        atletas.map((a) => {
          const idade = idadeNoAno(a.d);
          return "<tr><td><b>" + esc(a.n.trim().toUpperCase()) + "</b><span>" + esc(a.d.split("-").reverse().join("/")) + " · " + idade + " anos</span></td>" +
            "<td>" + esc(a.f) + "</td><td>" + (a.fe ? "🧸 Festival Kids" : esc(a.p) + (a.k ? "<span>" + esc(String(a.k).replace(".", ",")) + " kg</span>" : "")) + "</td>" +
            "<td class='esconder'>" + (a.s === "MASCULINO" ? "Masc." : "Fem.") + "</td></tr>";
        }).join("");
      $("textoTermos").innerHTML = textoTermos();
      $("aceiteLgpd").checked = false; $("aceiteSaude").checked = false; $("btEnviar").disabled = true;
      $("erroEnvio").hidden = true;
    }
    ["aceiteLgpd", "aceiteSaude"].forEach((id) => $(id).addEventListener("change", () => { $("btEnviar").disabled = !($("aceiteLgpd").checked && $("aceiteSaude").checked); }));

    // ---------- botões dos passos ----------
    ["profNome", "profEquipe", "profWhats", "profEmail"].forEach((id) => $(id).addEventListener("input", () => { marcarErro($(id), ""); salvarRascunho(); }));
    $("irPasso2").addEventListener("click", () => { if (validarProfessor()) { desenharAtletas(); irPara(2); } });
    $("voltarPasso1").addEventListener("click", () => irPara(1));
    $("irPasso3").addEventListener("click", () => { if (validarAtletas()) { montarResumo(); irPara(3); } });
    $("voltarPasso2").addEventListener("click", () => { desenharAtletas(); irPara(2); });

    // ---------- envio ----------
    function urlApi(extra) {
      const base = String(CFG.URL_API || "").split("#")[0].trim();
      return base + (base.indexOf("?") === -1 ? "?" : "&") + extra;
    }
    function jsonp(query, tempo) {
      return new Promise((resolve, reject) => {
        const nome = "g7insc_" + Date.now() + "_" + Math.floor(Math.random() * 1000), s = document.createElement("script");
        const t = setTimeout(() => { fim(); reject(new Error("tempo")); }, tempo || 30000);
        function fim() { clearTimeout(t); try { delete window[nome]; } catch (e) {} if (s.parentNode) s.parentNode.removeChild(s); }
        window[nome] = (d) => { fim(); resolve(d); };
        s.onerror = () => { fim(); reject(new Error("rede")); };
        s.src = urlApi(query + "&callback=" + nome + "&t=" + Date.now());
        document.body.appendChild(s);
      });
    }

    $("btEnviar").addEventListener("click", () => {
      const bt = $("btEnviar");
      const pacote = {
        professor: $("profNome").value.trim(), equipe: $("profEquipe").value.trim(),
        whatsapp: $("profWhats").value.trim(), email: $("profEmail").value.trim(),
        aceiteLgpd: $("aceiteLgpd").checked, aceiteSaude: $("aceiteSaude").checked, site_web: $("siteWeb").value,
        atletas: atletas.map((a) => ({ n: a.n.trim().replace(/\s+/g, " "), d: a.d, s: a.s, f: a.f, p: a.fe ? "" : a.p, k: a.fe ? "" : String(a.k || ""), fe: a.fe ? 1 : 0 }))
      };
      bt.disabled = true; bt.textContent = "Enviando...";
      $("erroEnvio").hidden = true;
      jsonp("api=inscricao&dados=" + encodeURIComponent(JSON.stringify(pacote)))
        .then((r) => {
          if (r && r.sucesso) {
            $("numProtocolo").textContent = r.protocolo;
            $("textoOk").innerHTML = "<b>" + r.total + " atleta(s)</b> inscrito(s) pela equipe <b>" + esc(pacote.equipe.toUpperCase()) + "</b>." +
              (r.repetidos && r.repetidos.length ? "<br>Já estavam inscritos antes e não foram repetidos: " + esc(r.repetidos.join(", ")) + "." : "") +
              (pacote.email ? "<br>Enviamos uma confirmação para " + esc(pacote.email) + "." : "") +
              "<br>Guarde o protocolo. Os atletas aparecem na checagem do evento depois da conferência da organização.";
            limparRascunhoAtletas();
            irPara(4);
          } else {
            $("erroEnvio").textContent = (r && r.mensagem) || "Não foi possível enviar.";
            $("erroEnvio").hidden = false;
            if (r && r.fechada) { $("formulario").hidden = true; $("fechado").hidden = false; }
          }
        })
        .catch(() => {
          $("erroEnvio").textContent = "Falha de conexão. Seus dados continuam aqui: confira a internet e toque em Enviar de novo.";
          $("erroEnvio").hidden = false;
        })
        .finally(() => { bt.textContent = "✅ Enviar inscrição"; bt.disabled = !($("aceiteLgpd").checked && $("aceiteSaude").checked); });
    });

    $("btNova").addEventListener("click", () => { atletas = [novoAtleta()]; salvarRascunho(); desenharAtletas(); irPara(2); });
    $("btCopiar").addEventListener("click", () => {
      const t = $("numProtocolo").textContent;
      try { navigator.clipboard.writeText(t).then(() => { $("btCopiar").textContent = "✓ Copiado"; }); } catch (e) {}
    });

    // ---------- carregar evento ----------
    function aplicarEvento(d) {
      evento = (d && d.evento) || {};
      $("nomeEvento").textContent = evento.nome || "Evento";
      document.title = "Inscrição · " + (evento.nome || "G7PRO");
      const partes = [];
      if (evento.data) { partes.push("📅 " + evento.data); const m = String(evento.data).match(/(\d{4})/); if (m) anoEvento = Number(m[1]); }
      if (evento.local) partes.push("📍 " + evento.local);
      $("infoEvento").textContent = partes.join(" · ");
      $("carregando").hidden = true;
      if (evento.inscricoesAbertas) { $("formulario").hidden = false; lerRascunho(); irPara(1); }
      else $("fechado").hidden = false;
    }
    if (!CFG.URL_API || CFG.URL_API.indexOf("script.google.com") === -1) {
      $("carregando").textContent = "Site sem configuração. Fale com a organização.";
    } else {
      fetch(urlApi("api=publico&t=" + Date.now()), { redirect: "follow" })
        .then((r) => { if (!r.ok) throw new Error(); return r.json(); })
        .catch(() => jsonp("api=publico", 20000))
        .then(aplicarEvento)
        .catch(() => { $("carregando").textContent = "Não foi possível carregar o evento. Atualize a página."; });
    }
  }
  </script>
</body>
</html>
